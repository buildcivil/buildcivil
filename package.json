{
  "name": "@buildcivil/source",
  "version": "0.0.0",
  "private": true,
  "description": "Build Civil monorepo — build-civil-code, renovaite, and roomify",
  "scripts": {
    "dev": "nx serve build-civil-code",
    "dev:bcc": "nx serve build-civil-code",
    "dev:renovaite": "nx serve renovaite",
    "dev:roomify": "nx serve roomify",
    "build": "nx run-many -t build",
    "build:bcc": "nx build build-civil-code",
    "build:renovaite": "nx build renovaite",
    "build:roomify": "nx build roomify",
    "lint": "nx run-many -t lint",
    "start:bcc": "nx start build-civil-code",
    "start:renovaite": "nx start renovaite",
    "start:roomify": "nx start roomify",
    "graph": "nx graph"
  },
  "devDependencies": {
    "nx": "^21.4.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "overrides": {
      "@buildcivil/renovaite>react": "18.3.1",
      "@buildcivil/renovaite>react-dom": "18.3.1",
      "@buildcivil/renovaite>@types/react": "18.3.31",
      "@buildcivil/renovaite>@types/react-dom": "18.3.5"
    }
  }
}
