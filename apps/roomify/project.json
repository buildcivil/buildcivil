{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "roomify",
  "projectType": "application",
  "sourceRoot": "apps/roomify/app",
  "tags": ["type:app", "scope:roomify"],
  "targets": {
    "serve": {
      "executor": "nx:run-script",
      "options": {
        "script": "serve"
      }
    },
    "dev": {
      "executor": "nx:run-script",
      "options": {
        "script": "dev"
      }
    },
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "outputs": ["{projectRoot}/build"]
    },
    "start": {
      "executor": "nx:run-script",
      "options": {
        "script": "start"
      }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": {
        "script": "typecheck"
      }
    }
  }
}
